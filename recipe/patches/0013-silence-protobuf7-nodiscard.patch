From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anaconda Recipes <recipe-maintainers@anaconda.com>
Date: Thu, 17 Sep 2026 10:00:00 -0600
Subject: [PATCH] Silence protobuf 7 nodiscard on ParseFromString

protobuf 7 declares MessageLite::ParseFromString [[nodiscard]]; the ignored
return value in OffsetMapVariant::Decode fails the linux build with
-Werror=unused-result. Cast to void to keep the existing behaviour.
---
 tensorflow_text/core/kernels/normalize_kernels.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tensorflow_text/core/kernels/normalize_kernels.cc b/tensorflow_text/core/kernels/normalize_kernels.cc
--- a/tensorflow_text/core/kernels/normalize_kernels.cc
+++ b/tensorflow_text/core/kernels/normalize_kernels.cc
@@ -193,7 +193,8 @@ bool OffsetMapVariant::Decode(const tensorflow::VariantTensorData& data) {
   string serialized;
   data.get_metadata(&serialized);
   EditChanges changes;
-  changes.ParseFromString(serialized);
+  // protobuf 7 marks ParseFromString [[nodiscard]].
+  (void)changes.ParseFromString(serialized);
   icu::Edits edit;
   icu::ErrorCode icu_error;
   for (int64 j = 0; j < changes.change_size(); ++j) {
