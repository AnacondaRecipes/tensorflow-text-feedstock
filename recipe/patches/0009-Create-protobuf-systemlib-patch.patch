+new file mode 100644
+index 0000000..e636420
+--- /dev/null
++++ b/third_party/protobuf_impl.bzl
+@@ -0,0 +1,126 @@
++
++def _must_run(ctx, args, what):
++    result = ctx.execute(args)
++    if result.return_code != 0:
++        fail("%s failed (%d): %s" % (what, result.return_code, result.stderr))
++
++def _protobuf_impl(ctx):
++    path = ctx.os.environ["PROTOBUF_BAZEL_DIR"]
++    _must_run(ctx, ["/bin/cp", "-rL", path, "."], "copying protobuf bazel dir %s" % path)
++
++    syslib_label = ctx.attr.systemlib
++    syslib_path = ctx.path(syslib_label)
++    _must_run(ctx, ["cp", syslib_path, "BUILD"], "copying systemlib BUILD")
++    ctx.report_progress("Copied systemlib.BUILD")
++
++    # Native proto_library depends on protoc_minimal; point at host protoc.
++    _must_run(ctx, ["mkdir", "-p", "src/google/protobuf/compiler"], "mkdir compiler")
++    ctx.file(
++        "src/google/protobuf/compiler/BUILD",
++        "genrule(name = \"protoc_minimal\", outs = [\"protoc_minimal.bin\"], cmd = \"ln -s $(PREFIX)/bin/protoc $@\", executable = 1, visibility = [\"//visibility:public\"])\n",
++    )
++
++    # Stub io targets referenced by TSL build_config.bzl.
++    _must_run(ctx, ["mkdir", "-p", "src/google/protobuf/io"], "mkdir io")
++    ctx.file(
++        "src/google/protobuf/io/BUILD",
++        "package(default_visibility = [\"//visibility:public\"])\n\ncc_library(name = \"io\", linkopts = [\"-lprotobuf\"])\n\ncc_library(name = \"tokenizer\", linkopts = [\"-lprotobuf\"])\n",
++    )
++
++    # python/ stubs required by protobuf-bazel-rules toolchains.
++    _must_run(ctx, ["mkdir", "-p", "python"], "mkdir python")
++    _must_run(ctx, ["cp", ctx.path(ctx.attr.python_build), "python/BUILD.bazel"], "copy python BUILD")
++
++    _must_run(ctx, ["mkdir", "-p", "python/google/protobuf"], "mkdir python/google/protobuf")
++    _must_run(ctx, ["cp", ctx.path(ctx.attr.python_google_build), "python/google/BUILD.bazel"], "copy python/google BUILD")
++    _must_run(ctx, ["cp", ctx.path(ctx.attr.python_google_protobuf_build), "python/google/protobuf/BUILD.bazel"], "copy python/google/protobuf BUILD")
++
++    # python/dist stubs referenced during repository mapping (protobuf_deps.bzl).
++    _must_run(ctx, ["mkdir", "-p", "python/dist"], "mkdir python/dist")
++    _must_run(ctx, ["cp", ctx.path(ctx.attr.python_dist_build), "python/dist/BUILD.bazel"], "copy python/dist BUILD")
++    _must_run(ctx, ["cp", ctx.path(ctx.attr.python_dist_system_python), "python/dist/system_python.bzl"], "copy system_python.bzl")
++
++    # Stub prebuilt toolchain registrations from copied bazel rules.
++    _must_run(ctx, ["mkdir", "-p", "toolchain"], "mkdir toolchain")
++    ctx.file("toolchain/BUILD", "")
++    ctx.file(
++        "toolchain/platforms.bzl",
++        "PROTOBUF_PLATFORMS = {}\n",
++    )
++
++    # WKT types live in system libprotobuf; skip cc codegen inside @com_google_protobuf.
++    cc_proto_bzl = "bazel/private/oss/cc_proto_library.bzl"
++    cc_proto_content = ctx.read(cc_proto_bzl)
++    aspect_impl_needle = "def _aspect_impl(target, ctx):\n    proto_info = target[ProtoInfo]"
++    aspect_impl_repl = """def _aspect_impl(target, ctx):
++    if target.label.workspace_name in ("com_google_protobuf", "org_tensorflow", "xla", "tsl"):
++        if CcInfo in ctx.attr._protobuf_runtime:
++            return [
++                ctx.attr._protobuf_runtime[CcInfo],
++                _ProtoCcFilesInfo(files = depset()),
++                OutputGroupInfo(),
++                _ProtoCcHeaderInfo(headers = depset()),
++            ]
++        return [
++            CcInfo(),
++            _ProtoCcFilesInfo(files = depset()),
++            OutputGroupInfo(),
++            _ProtoCcHeaderInfo(headers = depset()),
++        ]
++
++    proto_info = target[ProtoInfo]"""
++    aspect_attrs_needle = "    attrs = {\n                \"_cc_proto_library_header_suffixes\":"
++    aspect_attrs_repl = "    attrs = {\n                \"_protobuf_runtime\": attr.label(\n                    default = \"//:protobuf\",\n                ),\n                \"_cc_toolchain\": attr.label(\n                    default = \"@bazel_tools//tools/cpp:current_cc_toolchain\",\n                ),\n                \"_cc_proto_library_header_suffixes\":"
++    if aspect_impl_needle not in cc_proto_content:
++        fail("cc_proto_library.bzl: aspect impl anchor not found")
++    if aspect_attrs_needle not in cc_proto_content:
++        fail("cc_proto_library.bzl: aspect attrs anchor not found")
++    cc_proto_content = cc_proto_content.replace(aspect_impl_needle, aspect_impl_repl, 1)
++    cc_proto_content = cc_proto_content.replace(aspect_attrs_needle, aspect_attrs_repl, 1)
++    cc_proto_content = cc_proto_content.replace(
++        'load("@rules_cc//cc:find_cc_toolchain.bzl", "use_cc_toolchain")',
++        'load("@bazel_tools//tools/cpp:toolchain_utils.bzl", "use_cpp_toolchain")',
++    )
++    cc_proto_content = cc_proto_content.replace(
++        "use_cc_toolchain()",
++        "use_cpp_toolchain()",
++    )
++    ctx.file(cc_proto_bzl, cc_proto_content)
++
++    cc_proto_support_bzl = "bazel/private/cc_proto_support.bzl"
++    cc_proto_support_content = ctx.read(cc_proto_support_bzl)
++    cc_proto_support_content = cc_proto_support_content.replace(
++        'load("@rules_cc//cc:find_cc_toolchain.bzl", "find_cc_toolchain")',
++        'load("@bazel_tools//tools/cpp:toolchain_utils.bzl", "find_cpp_toolchain")',
++    )
++    cc_proto_support_content = cc_proto_support_content.replace(
++        "find_cc_toolchain(",
++        "find_cpp_toolchain(",
++    )
++    ctx.file(cc_proto_support_bzl, cc_proto_support_content)
++
++    # Bazel's ctx.fragments.proto suffix accessors are methods; use fixed defaults.
++    flags_bzl = "bazel/flags/flags.bzl"
++    flags_content = ctx.read(flags_bzl)
++    header_needle = 'getattr(ctx.fragments.proto, "cc_proto_library_header_suffixes")'
++    source_needle = 'getattr(ctx.fragments.proto, "cc_proto_library_source_suffixes")'
++    if header_needle not in flags_content:
++        fail("flags.bzl: header suffix needle not found")
++    if source_needle not in flags_content:
++        fail("flags.bzl: source suffix needle not found")
++    flags_content = flags_content.replace(header_needle, '[".pb.h"]')
++    flags_content = flags_content.replace(source_needle, '[".pb.cc"]')
++    ctx.file(flags_bzl, flags_content)
++
++protobuf_bazel_repo = repository_rule(
++    implementation = _protobuf_impl,
++    environ = ["PROTOBUF_BAZEL_DIR"],
++    attrs = {
