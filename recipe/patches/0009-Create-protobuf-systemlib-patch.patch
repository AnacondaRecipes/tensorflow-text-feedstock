++        "python_google_protobuf_build": attr.label(mandatory = True, allow_single_file = True),
++        "python_dist_build": attr.label(mandatory = True, allow_single_file = True),
++        "python_dist_system_python": attr.label(mandatory = True, allow_single_file = True),
++    },
++)
